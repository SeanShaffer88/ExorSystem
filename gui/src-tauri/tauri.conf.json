{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExorSystem",
  "version": "0.1.0",
  "identifier": "io.github.seanshaffer88.exorsystem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ExorSystem", "width": 1100, "height": 720, "minWidth": 800, "minHeight": 560 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
