{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExorSystem",
  "version": "0.2.0",
  "identifier": "io.github.seanshaffer88.exorsystem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ExorSystem",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      },
      {
        "label": "log",
        "title": "ExorSystem activity log",
        "url": "index.html#log",
        "parent": "main",
        "width": 800,
        "height": 220,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
