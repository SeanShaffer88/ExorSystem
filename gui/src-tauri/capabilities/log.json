{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "log",
  "description": "Read, clear, and close the local Activity log; no workspace commands",
  "windows": [
    "log"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-clear-log",
    "allow-get-log",
    "allow-set-log-open"
  ]
}
